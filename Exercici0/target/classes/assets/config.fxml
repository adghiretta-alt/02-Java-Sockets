<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.client.ConfigController"
    alignment="CENTER"
    spacing="15">

    <padding>
        <Insets
            top="30"
            right="50"
            bottom="30"
            left="50"/>
    </padding>

    <children>

        <Label text="SUDOKU MULTIJUGADOR">
            <style>
                -fx-font-size: 28px;
                -fx-font-weight: bold;
            </style>
        </Label>

        <Label text="Nombre del jugador"/>

        <TextField
            fx:id="txtName"
            promptText="Ejemplo: Albert"/>

        <Label text="Servidor"/>

        <TextField
            fx:id="txtHost"
            text="localhost"/>

        <Label text="Puerto"/>

        <TextField
            fx:id="txtPort"
            text="3000"/>

        <Button
            text="CONECTAR"
            onAction="#connect"/>

        <Label
            fx:id="lblMessage"
            text=""/>

    </children>

</VBox>